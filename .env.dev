# purpose: Local development env (versioned on purpose; disposable credentials)
# Localhost only — never copy these values to .env.staging / .env.production
# Used by: docker-compose.yml and docker-compose.dev.yml

# --- Environment ---
NODE_ENV=development
AUTH_PORT=3001
USERS_PORT=3002
SERVICE_ORDERS_PORT=3003
PAYMENTS_PORT=3004
REVIEWS_PORT=3005

# --- Public API Domain ---
# Deploy only; empty locally.
API_DOMAIN=""

# --- Database ---
# Between containers: postgres:5432. From host: localhost:15432
# (the system Postgres uses 5432).
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/pode_deixar?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/pode_deixar?schema=public"

# --- Local Postgres ---
# Values for compose variable interpolation.
POSTGRES_DB=pode_deixar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- JWT ---
# DEV ONLY — disposable, >= 32 chars required at boot;
# never use in staging/production.
JWT_ACCESS_SECRET="dev-only-nao-usar-em-prod-access-0123456789"
JWT_REFRESH_SECRET="dev-only-nao-usar-em-prod-refresh-0123456789"

# --- Frontend ---
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# --- Redis ---
REDIS_URL="redis://redis:6379"

# --- Rate Limiting ---
THROTTLER_PREFIX="throttler:"

# --- MinIO ---
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

MINIO_SERVICE_IMAGES_BUCKET="service-images"
MINIO_AVATARS_BUCKET="avatars"
MINIO_ORDER_PHOTOS_BUCKET="order-photos"
MINIO_PUBLIC_URL="http://localhost:8080/api/storage"

# --- SMTP ---
# Mailpit locally; inbox at localhost:8025.
# No TLS: Mailpit does not implement STARTTLS (replies 502).
SMTP_HOST="mailpit"
SMTP_PORT=1025
SMTP_REQUIRE_TLS=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="nao-responda@pode-deixar.local"

# --- Security ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# --- Webhooks ---
MOCK_WEBHOOK_KEY="dev-mock-webhook-key"

# --- Provider Finance ---
PLATFORM_FEE_RATE=0.10

# --- Payment Gateways ---
# Empty = mock gateway, no external calls.
PAYMENT_GATEWAY_ACCESS_TOKEN=""
PAYMENT_GATEWAY_WEBHOOK_SECRET="dev-webhook-secret"
PAYMENT_GATEWAY_NOTIFICATION_URL=""
PAYMENT_GATEWAY_PAYER_EMAIL="sandbox@pode-deixar.com"
