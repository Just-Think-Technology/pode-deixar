# ============================================================
# .env.dev — desenvolvimento LOCAL (versionado de propósito).
# Só localhost + credenciais descartáveis de dev. NUNCA copiar estes
# valores para .env.staging / .env.production.
# Usado por: docker-compose.yml e docker-compose.dev.yml
# ============================================================

# -- Environment --
NODE_ENV=development
AUTH_PORT=3001
USERS_PORT=3002
SERVICE_ORDERS_PORT=3003
PAYMENTS_PORT=3004
REVIEWS_PORT=3005

# -- Domínio público da API (só deploy; vazio no local) --
API_DOMAIN=""

# -- Database (Postgres local do compose) --
# Entre containers: postgres:5432. Do host: localhost:15432
# (o Postgres do sistema ocupa a 5432).
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/pode_deixar?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/pode_deixar?schema=public"

# -- Postgres local (lido na interpolação do compose) --
POSTGRES_DB=pode_deixar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -- JWT (DEV ONLY — descartáveis, >= 32 chars exigidos no boot;
# nunca usar em staging/produção) --
JWT_ACCESS_SECRET="dev-only-nao-usar-em-prod-access-0123456789"
JWT_REFRESH_SECRET="dev-only-nao-usar-em-prod-refresh-0123456789"

# -- Frontend (local via Caddy) --
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# -- Redis (dentro do compose) --
REDIS_URL="redis://redis:6379"

# -- Rate Limiting --
THROTTLER_PREFIX="throttler:"

# -- MinIO (local, credenciais padrão de dev) --
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

MINIO_SERVICE_IMAGES_BUCKET="service-images"
MINIO_AVATARS_BUCKET="avatars"
MINIO_ORDER_PHOTOS_BUCKET="order-photos"
MINIO_PUBLIC_URL="http://localhost:8080/api/storage"

# -- SMTP (Mailpit local; ler em localhost:8025) --
# Sem TLS: o Mailpit não implementa STARTTLS (responde 502).
SMTP_HOST="mailpit"
SMTP_PORT=1025
SMTP_REQUIRE_TLS=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="nao-responda@pode-deixar.local"

# -- Security --
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# -- Webhooks (Payments, mock local) --
MOCK_WEBHOOK_KEY="dev-mock-webhook-key"

# -- Financeiro do Prestador (Payments) --
PLATFORM_FEE_RATE=0.10

# -- Gateways de Pagamento (vazio = gateway mock, sem chamada externa) --
PAYMENT_GATEWAY_ACCESS_TOKEN=""
PAYMENT_GATEWAY_WEBHOOK_SECRET="dev-webhook-secret"
PAYMENT_GATEWAY_NOTIFICATION_URL=""
PAYMENT_GATEWAY_PAYER_EMAIL="sandbox@pode-deixar.com"
