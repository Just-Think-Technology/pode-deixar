{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "test/components/ui/button.spec.tsx",
    "test/components/ui/alert.spec.tsx",
    "test/components/ui/card.spec.tsx",
    "test/components/ui/input.spec.tsx",
    "test/components/ui/input-otp.spec.tsx",
    "test/hooks/use-mobile.spec.tsx",
    "test/pages/auth-form-page.spec.tsx",
    "e2e/**",
    ".next",
    "dist",
    "coverage",
    "vitest.config.ts",
    "vite.config.ts",
    "tailwind.config.ts",
    "postcss.config.js",
    "next.config.js"
  ]
}
