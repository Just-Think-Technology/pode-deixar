# Frontend dev image — Next.js development with hot-reload

FROM node:22-alpine
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

COPY . .

# Arquivos como `node`: o compose roda com `user: "node"` e o volume
# frontend_node_modules herda o dono da imagem. Sem isso, EACCES.
RUN chown -R node:node /app && mkdir -p /home/node && chown node:node /home/node
ENV HOME=/home/node
USER node

EXPOSE 3000
CMD ["pnpm", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
