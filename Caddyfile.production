# purpose: Reverse proxy for staging/production deploy (mounted at /etc/caddy/Caddyfile)
# {$API_DOMAIN} comes from the environment (e.g.: api-staging.seudominio.com).
# Automatic HTTPS (requires published 80/443 and DNS pointing to the VPS).

{$API_DOMAIN} {

    # --- Auth Health ---
    # Different strip: /health, not /auth/health
    handle /api/auth/health* {
        uri strip_prefix /api/auth
        reverse_proxy auth:3001
    }

    # --- Users Health ---
    handle /api/users/health* {
        uri strip_prefix /api/users
        reverse_proxy users:3002
    }

    # --- Service Orders Health ---
    # Missing from the dev Caddyfile — without this handle, /api/services/health
    # falls into the generic proxy below and returns 404
    handle /api/services/health* {
        uri strip_prefix /api/services
        reverse_proxy service-orders:3003
    }

    # --- Payments Health ---
    handle /api/payments/health* {
        uri strip_prefix /api/payments
        reverse_proxy payments:3004
    }

    # --- Reviews Health ---
    handle /api/reviews/health* {
        uri strip_prefix /api/reviews
        reverse_proxy reviews:3005
    }

    # --- Auth Service ---
    handle /api/auth/* {
        uri strip_prefix /api
        reverse_proxy auth:3001
    }

    # --- Users Service ---
    handle /api/profiles/* {
        uri strip_prefix /api
        reverse_proxy users:3002
    }

    handle /api/providers/* {
        uri strip_prefix /api
        reverse_proxy users:3002
    }

    # --- Users Service (Categories) ---
    handle /api/categories* {
        uri strip_prefix /api
        reverse_proxy users:3002
    }

    # --- Service Orders Service ---
    handle /api/services/* {
        uri strip_prefix /api
        reverse_proxy service-orders:3003
    }

    handle /api/proposals/* {
        uri strip_prefix /api
        reverse_proxy service-orders:3003
    }

    # --- Payments Service ---
    handle /api/payments/* {
        uri strip_prefix /api
        reverse_proxy payments:3004
    }

    # --- Reviews Service ---
    handle /api/reviews/* {
        uri strip_prefix /api
        reverse_proxy reviews:3005
    }

    # --- Public Storage ---
    # MINIO_PUBLIC_URL must point to {$API_DOMAIN}/api/storage
    handle /api/storage/* {
        uri strip_prefix /api/storage
        reverse_proxy minio:9000
    }
}
