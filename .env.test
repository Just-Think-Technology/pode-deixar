# Arquivo de ambiente para rodar os testes (CI e local).

# -- Environment --
NODE_ENV=test
AUTH_PORT=3001
USERS_PORT=3002
SERVICE_ORDERS_PORT=3003
PAYMENTS_PORT=3004
REVIEWS_PORT=3005

# -- Frontend --
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# -- Webhooks (Payments) --
MOCK_WEBHOOK_KEY=test-mock-webhook-key

# -- Financeiro do Prestador (Payments) --
PLATFORM_FEE_RATE=0.10

# -- JWT --
JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret

# -- SMTP (Email) --
# Aponta pra um servidor SMTP fake local (ex.: Mailhog/Maildev) — se o
# serviço não usa nenhum desses em CI, estes valores só existem pra
# satisfazer validação de config.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=test@pode-deixar.com

# -- Security --
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# -- MinIO (Object Storage) --
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SERVICE_IMAGES_BUCKET=service-images
MINIO_AVATARS_BUCKET=avatars
MINIO_ORDER_PHOTOS_BUCKET=order-photos
MINIO_PUBLIC_URL=http://localhost:8080/api/storage

# -- Database (sobrescrito por serviço no CI, ver ci-backend.yml) --
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pode_deixar_test?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pode_deixar_test?schema=public

# -- Gateways de Pagamento --
# Vazio de propósito: a ausência de PAYMENT_GATEWAY_ACCESS_TOKEN é o que
# ativa o gateway mock (ver comentário no .env.example). Não preencher.
PAYMENT_GATEWAY_ACCESS_TOKEN=
PAYMENT_GATEWAY_WEBHOOK_SECRET=test-webhook-secret
PAYMENT_GATEWAY_NOTIFICATION_URL=https://example.com/api/payments/webhook/mercadopago
PAYMENT_GATEWAY_PAYER_EMAIL=sandbox@pode-deixar.com
