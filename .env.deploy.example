# ============================================================
# Exemplo de env para deploy (staging e produção).
# Copie para .env.staging / .env.production e PREENCHA OS SEGREDOS.
# Nunca commite os arquivos reais — eles são montados no deploy via secrets.
# ============================================================

# -- Domínio público da API (vhost do Caddy, com HTTPS automático) --
API_DOMAIN="api-staging.seudominio.com"

# -- Banco (Neon). Um por ambiente. Inclua ?sslmode=require --
DATABASE_URL="postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/pode_deixar?sslmode=require"
DIRECT_DATABASE_URL="postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/pode_deixar?sslmode=require"

# -- JWT (gere valores longos e aleatórios, diferentes por ambiente) --
JWT_ACCESS_SECRET="troque-por-64-caracteres-aleatorios"
JWT_REFRESH_SECRET="troque-por-64-caracteres-aleatorios"

# -- Frontend (URLs do Vercel por ambiente) --
FRONTEND_URL="https://seu-app-staging.vercel.app"
ALLOWED_ORIGINS="https://seu-app-staging.vercel.app"

# -- Redis (dentro do compose; aquí nada muda entre ambientes) --
REDIS_URL="redis://redis:6379"

# -- MinIO (dentro do compose; troque as credenciais por ambiente) --
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_ACCESS_KEY="troque-minio-user"
MINIO_SECRET_KEY="troque-minio-pass-com-8-caracteres-no-minimo"
MINIO_SERVICE_IMAGES_BUCKET="service-images"
MINIO_AVATARS_BUCKET="avatars"
MINIO_ORDER_PHOTOS_BUCKET="order-photos"
MINIO_PUBLIC_URL="https://api-staging.seudominio.com/api/storage"

# -- SMTP (Resend ou Brevo em produção; Mailpit é só local) --
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS="troque-pela-chave"
SMTP_FROM="nao-responda@seudominio.com"

# -- Webhook mock (uso interno/testes; chave longa e aleatória) --
MOCK_WEBHOOK_KEY="troque-por-valor-aleatorio-longo"

# -- Financeiro --
PLATFORM_FEE_RATE=0.10

# -- Mercado Pago (vazio = gateway mock; TEST- em staging, APP_USR- em prod) --
PAYMENT_GATEWAY_ACCESS_TOKEN=""
PAYMENT_GATEWAY_WEBHOOK_SECRET="troque-pelo-segredo-do-webhook"
PAYMENT_GATEWAY_NOTIFICATION_URL="https://api-staging.seudominio.com/api/payments/webhook/mercadopago"
PAYMENT_GATEWAY_PAYER_EMAIL=""

# -- Segurança --
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# -- Portas internas (padrões; só mude se conflitar) --
AUTH_PORT=3001
USERS_PORT=3002
SERVICE_ORDERS_PORT=3003
PAYMENTS_PORT=3004
REVIEWS_PORT=3005
