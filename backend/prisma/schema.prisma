generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [unaccent]
}

enum Role {
  CLIENT
  ADMIN
  PROVIDER
}

model User {
  id                      String             @id @default(uuid())
  completeName            String             @map("complete_name")
  email                   String             @unique
  password                String
  role                    Role               @default(CLIENT)
  phone                   String
  postalCode              String             @map("postal_code")
  emailVerified           Boolean            @default(false) @map("email_verified")
  emailVerificationToken  String?            @map("email_verification_token")
  emailVerificationExpires DateTime?          @map("email_verification_expires")
  passwordResetToken      String?            @map("password_reset_token")
  passwordResetExpires    DateTime?          @map("password_reset_expires")
  refreshToken            String?            @map("refresh_token")
  refreshTokenFamily      String?            @map("refresh_token_family")
  failedLoginAttempts     Int                @default(0) @map("failed_login_attempts")
  lockoutUntil            DateTime?          @map("lockout_until")
  lastLoginAt             DateTime?          @map("last_login_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  clientProfile           ClientProfile?
  providerProfile         ProviderProfile?

  @@map("users")
}

model ClientProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  avatarUrl   String?  @map("avatar_url")
  preferences Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model ProviderProfile {
  id           String             @id @default(uuid())
  userId       String             @unique @map("user_id")
  avatarUrl    String?            @map("avatar_url")
  bio          String?
  hourlyRate   Decimal?           @map("hourly_rate") @db.Decimal(10, 2)
  skills       String[]           @default([])
  portfolio    Json?              @default("[]")
  rating       Float              @default(0)
  totalReviews Int                @default(0) @map("total_reviews")
  isAvailable  Boolean            @default(true) @map("is_available")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     ProviderService[]

  @@map("provider_profiles")
}

model Category {
  id          String             @id @default(uuid())
  name        String             @unique
  slug        String             @unique
  description String?
  icon        String?
  order       Int                @default(0)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  services    ProviderService[]
  serviceOrders ServiceOrder[]

  @@map("categories")
}

model ProviderService {
  id                String           @id @default(uuid())
  providerProfile   ProviderProfile  @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  providerProfileId String           @map("provider_profile_id")
  title             String
  description       String           @db.Text
  fixedPrice        Decimal          @db.Decimal(10, 2) @map("fixed_price")
  categoryId        String           @map("category_id")
  category          Category         @relation(fields: [categoryId], references: [id])
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  images            ServiceImage[]

  @@map("provider_services")
}

model ServiceImage {
  id                String          @id @default(uuid())
  providerService   ProviderService @relation(fields: [providerServiceId], references: [id], onDelete: Cascade)
  providerServiceId String          @map("provider_service_id")
  url               String
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("service_images")
}

enum ServiceOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum CounterProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

model ServiceOrder {
  id          String             @id @default(uuid())
  clientId    String             @map("client_id")
  providerId  String?            @map("provider_id")
  providerServiceId String?      @map("provider_service_id")
  agreedPrice Decimal?           @map("agreed_price") @db.Decimal(10, 2)
  title       String
  description String             @db.Text
  categoryId  String             @map("category_id")
  category    Category           @relation(fields: [categoryId], references: [id])
  budgetMin   Decimal?           @map("budget_min") @db.Decimal(10, 2)
  budgetMax   Decimal?           @map("budget_max") @db.Decimal(10, 2)
  address     Json?              @default("{}")
  status      ServiceOrderStatus @default(OPEN)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  proposals   Proposal[]
  photos      OrderPhoto[]
  payments    Payment[]

  @@map("service_orders")
}

model Proposal {
  id               String         @id @default(uuid())
  serviceOrderId   String         @map("service_order_id")
  providerId       String         @map("provider_id")
  price            Decimal        @db.Decimal(10, 2)
  description      String         @db.Text
  estimatedDuration String?       @map("estimated_duration")
  status           ProposalStatus @default(PENDING)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  serviceOrder      ServiceOrder      @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  counterProposals  CounterProposal[]

  @@map("proposals")
}

model CounterProposal {
  id               String                @id @default(uuid())
  proposalId       String                @map("proposal_id")
  senderId         String                @map("sender_id")
  price            Decimal               @db.Decimal(10, 2)
  description      String                @db.Text
  estimatedDuration String?              @map("estimated_duration")
  status           CounterProposalStatus @default(PENDING)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  proposal         Proposal              @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("counter_proposals")
}

model OrderPhoto {
  id        String   @id @default(uuid())
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceOrderId String   @map("service_order_id")
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_photos")
}

model Payment {
  id             String        @id @default(uuid())
  serviceOrder   ServiceOrder  @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceOrderId String        @map("service_order_id")
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("BRL")
  method         PaymentMethod @default(PIX)
  status         PaymentStatus @default(PENDING)
  externalRef    String?       @map("external_ref")
  idempotencyKey String?       @map("idempotency_key")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([serviceOrderId, idempotencyKey])
  @@map("payments")
}

model TokenBlacklist {
  jti        String   @id
  expiresAt  DateTime @map("expires_at")

  @@map("token_blacklist")
}
