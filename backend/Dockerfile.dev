FROM node:22-alpine AS base
RUN apk update && apk add --no-cache openssl
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY shared/logger/package.json ./shared/logger/
COPY shared/email/package.json ./shared/email/
COPY shared/security/package.json ./shared/security/
COPY shared/validation/package.json ./shared/validation/
COPY services/auth/package.json ./services/auth/
COPY services/users/package.json ./services/users/
COPY services/service-orders/package.json ./services/service-orders/
COPY services/payments/package.json ./services/payments/
COPY services/reviews/package.json ./services/reviews/
COPY prisma ./prisma

RUN pnpm install --frozen-lockfile
RUN pnpm exec prisma generate --schema=prisma/schema.prisma

# Shared package dist is NOT built here: sources arrive via volume mounts at
# runtime, so each service builds it on start (prestart:dev) and keeps it
# fresh (watch:* scripts). Baking host dist into the image would reintroduce
# the stale-dist MODULE_NOT_FOUND failures.

# Arquivos como `node`: os serviços rodam com `user: "node"` e precisam
# escrever em /app (prisma generate, tsbuildinfo). Sem isso, EACCES.
RUN chown -R node:node /app && mkdir -p /home/node && chown node:node /home/node
ENV HOME=/home/node
USER node

FROM base AS auth-build
FROM base AS users-build
FROM base AS service-orders-build
FROM base AS payments-build
FROM base AS reviews-build
