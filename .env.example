# ============================================================
# Template único de ambiente (local, staging e produção).
# Copie para .env.staging / .env.production e PREENCHA OS SEGREDOS.
# Nunca commite os arquivos reais — em deploy eles vêm de secrets.
# Arquivos de env no repo: .env.staging, .env.production, .env.test
# e este .env.example (somente este é versionado).
# ============================================================

# -- Environment --
NODE_ENV=example
AUTH_PORT=3001
USERS_PORT=3002
SERVICE_ORDERS_PORT=3003
PAYMENTS_PORT=3004
REVIEWS_PORT=3005

# -- Domínio público da API (vhost do Caddy no deploy, com HTTPS automático) --
# Local: vazio (Caddy local em http://localhost:8080 via Caddyfile.docker).
# Staging/prod: api-staging.seudominio.com / api.seudominio.com
API_DOMAIN=""

# -- Database (Neon) --
# Um banco por ambiente, sempre com ?sslmode=require.
# O compose local usa o banco de STAGING (DATABASE_URL do .env.staging);
# não há Postgres local. O deploy usa o DATABASE_URL do env de cada stack.
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# -- JWT (gere valores longos e aleatórios, diferentes por ambiente) --
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# -- Frontend --
# Local: http://localhost:3000 (ou :8080 via Caddy). Deploy: URL do Vercel
# de cada ambiente (staging = preview/develop, prod = main).
FRONTEND_URL=""
ALLOWED_ORIGINS="http://localhost:3000"

# -- Redis (dentro do compose; nada muda entre ambientes) --
REDIS_URL="redis://redis:6379"

# -- Rate Limiting --
# Prefixo das chaves do throttler no Redis (default usado pelo backend: "throttler:")
THROTTLER_PREFIX="throttler:"

# -- MinIO (Object Storage) --
# Local: endpoint localhost + credenciais padrão por conveniência (nunca
# usar minioadmin em staging/produção — troque as credenciais por ambiente).
# Deploy: MINIO_ENDPOINT=minio (dentro do compose).
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"

MINIO_SERVICE_IMAGES_BUCKET="service-images"
MINIO_AVATARS_BUCKET="avatars"
MINIO_ORDER_PHOTOS_BUCKET="order-photos"
# Local: http://localhost:8080/api/storage
# Deploy: https://<API_DOMAIN>/api/storage
MINIO_PUBLIC_URL="http://localhost:8080/api/storage"

# -- SMTP (Email) --
# Local: Mailpit (SMTP_HOST=mailpit, porta 1025). Deploy: Resend ou Brevo.
SMTP_HOST=""
SMTP_PORT=
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# -- Security --
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# -- Webhooks (Payments) --
# Chave exigida no header x-webhook-key do webhook mock (simulador local). Sem ela, o endpoint rejeita.
MOCK_WEBHOOK_KEY=""

# -- Financeiro do Prestador (Payments) --
# Taxa retida pela plataforma sobre o valor bruto do pagamento (0.10 = 10%). Calculada no backend no momento da criação do pagamento.
PLATFORM_FEE_RATE=0.10

# -- Gateways de Pagamento --
# Arquitetura de gateways (port/adapter): as variáveis PAYMENT_GATEWAY_* configuram o
# gateway de pagamento ativo (hoje: Mercado Pago). O gateway é selecionado automaticamente
# pela presença de PAYMENT_GATEWAY_ACCESS_TOKEN válido para o NODE_ENV. Com token
# configurado, o gateway real é usado para PIX; sem token, o gateway mock assume
# (nenhuma chamada externa). Cartão de crédito segue sempre via mock
# (tokenização real ainda não implementada).
# Access token de testes do Mercado Pago: começa com TEST- (painel > Credenciais de teste);
# em produção, use o token APP_USR- correspondente ao NODE_ENV.
# Staging: TEST- ou vazio (= mock). Produção: APP_USR-.
PAYMENT_GATEWAY_ACCESS_TOKEN=""
# Chave secreta para validar assinatura HMAC do webhook (headers x-signature e x-request-id).
# Obrigatória em produção: sem ela, o webhook do gateway é rejeitado (fail-closed).
PAYMENT_GATEWAY_WEBHOOK_SECRET=""
# URL pública do webhook do gateway, rota /api/payments/webhook/:gateway
# (ex.: /api/payments/webhook/mercadopago; usada para testes locais via tunnel, ex.: ngrok).
# Deve ser HTTPS. Deploy: https://<API_DOMAIN>/api/payments/webhook/mercadopago
PAYMENT_GATEWAY_NOTIFICATION_URL=""
# Email do pagador usado nas cobranças sandbox (opcional; default sandbox@pode-deixar.com)
PAYMENT_GATEWAY_PAYER_EMAIL=""
