# -- Environment --
NODE_ENV=""
AUTH_PORT=3001
USERS_PORT=3002
SERVICE_ORDERS_PORT=3003
PAYMENTS_PORT=3004

# -- Frontend --
FRONTEND_URL=""
ALLOWED_ORIGINS="http://localhost:3000"

# -- Webhooks (Payments) --
# Chave exigida no header x-webhook-key do webhook mock (simulador local). Sem ela, o endpoint rejeita.
MOCK_WEBHOOK_KEY=""

# -- JWT --
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# -- SMTP (Email) --
SMTP_HOST=""
SMTP_PORT=
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# -- Security --
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# -- MinIO (Object Storage) --
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"

MINIO_SERVICE_IMAGES_BUCKET="service-images"
MINIO_AVATARS_BUCKET="avatars"
MINIO_ORDER_PHOTOS_BUCKET="order-photos"
MINIO_PUBLIC_URL="http://localhost:8080/api/storage"

# -- Database (Neon) --
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# -- Mercado Pago (Sandbox) --
# Access token de testes: começa com TEST- (painel Mercado Pago > Credenciais de teste)
MERCADO_PAGO_ACCESS_TOKEN=""
# Chave secreta para validar assinatura do webhook (opcional durante testes)
MERCADO_PAGO_WEBHOOK_SECRET=""
# URL pública do endpoint /api/payments/webhook/mercadopago (usada para testes locais via tunnel)
MERCADO_PAGO_NOTIFICATION_URL=""
# Email do pagador usado nas cobranças sandbox (opcional; default sandbox@pode-deixar.com)
MERCADO_PAGO_PAYER_EMAIL=""
