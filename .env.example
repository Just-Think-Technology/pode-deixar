# purpose: Single environment template (local, staging, production)
# Copy to .env.staging / .env.production and fill in the secrets
# Real files are not committed — deploy takes them from secrets
# Versioned env files: .env.dev, .env.test, and this template

# --- Environment ---
NODE_ENV=example
AUTH_PORT=3001
USERS_PORT=3002
SERVICE_ORDERS_PORT=3003
PAYMENTS_PORT=3004
REVIEWS_PORT=3005

# --- Public API Domain ---
# Local: empty (local Caddy at http://localhost:8080 via Caddyfile.docker).
# Staging/prod: api-staging.seudoseaweedfs.com / api.seudoseaweedfs.com
API_DOMAIN=""

# --- Database ---
# Local: own Postgres via compose (DATABASE_URL overridden in
# docker-compose.yml; host localhost:15432, between containers postgres:5432).
# Staging/prod: one Neon per environment, always with ?sslmode=require.
# Deploy uses each stack's env DATABASE_URL.
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# --- JWT ---
# Generate long random values, different per environment.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# --- Frontend ---
# Local: http://localhost:3000 (or :8080 via Caddy). Deploy: each
# environment's Vercel URL (staging = preview/develop, prod = main).
FRONTEND_URL=""
ALLOWED_ORIGINS="http://localhost:3000"

# --- Redis ---
# Inside compose; same across environments.
REDIS_URL="redis://redis:6379"

# --- Rate Limiting ---
# Throttler key prefix in Redis (backend default: "throttler:")
THROTTLER_PREFIX="throttler:"

# --- SeaweedFS ---
# Local: localhost endpoint + default dev credentials for convenience (never
# use seaweedfsadmin in staging/production — rotate credentials per environment).
# Deploy: SEAWEEDFS_ENDPOINT=seaweedfs (inside compose).
SEAWEEDFS_ENDPOINT="localhost"
SEAWEEDFS_PORT=9000
SEAWEEDFS_ACCESS_KEY="seaweedfsadmin"
SEAWEEDFS_SECRET_KEY="seaweedfsadmin"
# SeaweedFS server root user/password (the server only reads SEAWEEDFS_ROOT_*;
# mirror the ACCESS/SECRET_KEY values per environment). Without them, SeaweedFS
# starts with seaweedfsadmin and services cannot authenticate on storage.
SEAWEEDFS_ROOT_USER="seaweedfsadmin"
SEAWEEDFS_ROOT_PASSWORD="seaweedfsadmin"

SEAWEEDFS_SERVICE_IMAGES_BUCKET="service-images"
SEAWEEDFS_AVATARS_BUCKET="avatars"
SEAWEEDFS_ORDER_PHOTOS_BUCKET="order-photos"
# Local: http://localhost:8080/api/storage
# Deploy: https://<API_DOMAIN>/api/storage
SEAWEEDFS_PUBLIC_URL="http://localhost:8080/api/storage"

# --- SMTP ---
# Local: Mailpit (SMTP_HOST=mailpit, port 1025, SMTP_REQUIRE_TLS=false —
# Mailpit does not implement STARTTLS). Deploy: Resend or Brevo (TLS
# required by default; only disable with SMTP_REQUIRE_TLS=false).
SMTP_HOST=""
SMTP_PORT=
SMTP_REQUIRE_TLS="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Security ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# --- Webhooks ---
# Key required in the mock webhook x-webhook-key header (local simulator). Without it, the endpoint rejects.
MOCK_WEBHOOK_KEY=""

# --- Provider Finance ---
# Platform fee on gross payment value (0.10 = 10%). Computed in the backend at payment creation.
PLATFORM_FEE_RATE=0.10

# --- Payment Gateways ---
# Gateway architecture (port/adapter): PAYMENT_GATEWAY_* vars configure the
# active payment gateway (today: Mercado Pago). The gateway is selected
# automatically by the presence of a valid PAYMENT_GATEWAY_ACCESS_TOKEN for
# the NODE_ENV. With a token configured, the real gateway handles PIX;
# without a token, the mock gateway takes over (no external calls). Credit
# card always goes via mock (real tokenization not implemented yet).
# Mercado Pago test access token: starts with TEST- (dashboard > test credentials);
# in production, use the APP_USR- token matching the NODE_ENV.
# Staging: TEST- or empty (= mock). Production: APP_USR-.
PAYMENT_GATEWAY_ACCESS_TOKEN=""
# Secret to validate the gateway webhook HMAC signature (x-signature and x-request-id headers).
# Required in production: without it, the gateway webhook is rejected (fail-closed).
PAYMENT_GATEWAY_WEBHOOK_SECRET=""
# Public gateway webhook URL, route /api/payments/webhook/:gateway
# (e.g.: /api/payments/webhook/mercadopago; used for local tests via tunnel, e.g.: ngrok).
# Must be HTTPS. Deploy: https://<API_DOMAIN>/api/payments/webhook/mercadopago
PAYMENT_GATEWAY_NOTIFICATION_URL=""
# Payer email used in sandbox charges (optional; default sandbox@pode-deixar.com)
PAYMENT_GATEWAY_PAYER_EMAIL=""
