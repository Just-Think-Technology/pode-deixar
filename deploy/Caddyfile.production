# purpose: Reverse proxy for staging/production deploy (mounted at /etc/caddy/Caddyfile)
# {$API_DOMAIN} comes from the environment (e.g.: api-staging.seudominio.com).
# Automatic HTTPS (requires published 80/443 and DNS pointing to the VPS).

{$API_DOMAIN} {
	# --- API v1 (versioned) ---
	handle /api/v1/auth/health* {
		uri strip_prefix /api/v1/auth
		reverse_proxy auth:3001
	}

	handle /api/v1/users/health* {
		uri strip_prefix /api/v1/users
		reverse_proxy users:3002
	}

	handle /api/v1/services/health* {
		uri strip_prefix /api/v1/services
		reverse_proxy service-orders:3003
	}

	handle /api/v1/payments/health* {
		uri strip_prefix /api/v1/payments
		reverse_proxy payments:3004
	}

	handle /api/v1/reviews/health* {
		uri strip_prefix /api/v1/reviews
		reverse_proxy reviews:3005
	}

	handle /api/v1/auth/* {
		uri strip_prefix /api/v1
		reverse_proxy auth:3001
	}

	handle /api/v1/profiles/* {
		uri strip_prefix /api/v1
		reverse_proxy users:3002
	}

	handle /api/v1/providers/* {
		uri strip_prefix /api/v1
		reverse_proxy users:3002
	}

	handle /api/v1/categories* {
		uri strip_prefix /api/v1
		reverse_proxy users:3002
	}

	handle /api/v1/services/* {
		uri strip_prefix /api/v1
		reverse_proxy service-orders:3003
	}

	handle /api/v1/proposals/* {
		uri strip_prefix /api/v1
		reverse_proxy service-orders:3003
	}

	handle /api/v1/payments/* {
		uri strip_prefix /api/v1
		reverse_proxy payments:3004
	}

	handle /api/v1/reviews/* {
		uri strip_prefix /api/v1
		reverse_proxy reviews:3005
	}

	handle /api/v1/storage/* {
		uri strip_prefix /api/v1/storage
		reverse_proxy minio:9000
	}

	# --- Legacy API (deprecated) ---
	handle /api/auth/health* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api/auth
		reverse_proxy auth:3001
	}

	handle /api/users/health* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api/users
		reverse_proxy users:3002
	}

	handle /api/services/health* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api/services
		reverse_proxy service-orders:3003
	}

	handle /api/payments/health* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api/payments
		reverse_proxy payments:3004
	}

	handle /api/reviews/health* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api/reviews
		reverse_proxy reviews:3005
	}

	handle /api/auth/* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api
		reverse_proxy auth:3001
	}

	handle /api/profiles/* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api
		reverse_proxy users:3002
	}

	handle /api/providers/* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api
		reverse_proxy users:3002
	}

	handle /api/categories* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api
		reverse_proxy users:3002
	}

	handle /api/services/* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api
		reverse_proxy service-orders:3003
	}

	handle /api/proposals/* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api
		reverse_proxy service-orders:3003
	}

	handle /api/payments/* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api
		reverse_proxy payments:3004
	}

	handle /api/reviews/* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api
		reverse_proxy reviews:3005
	}

	handle /api/storage/* {
		header Deprecation "true"
		header Sunset "Sat, 31 Dec 2026 23:59:59 GMT"
		uri strip_prefix /api/storage
		reverse_proxy minio:9000
	}
}
