{
  "title": "Pode Deixar — Erros e busca em logs",
  "uid": "pode-deixar-logs",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "definition": "label_values(service)",
        "query": { "query": "label_values(service)", "refId": "ServiceVarQuery" },
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Buscar (ex.: orderId)",
        "type": "textbox",
        "current": { "selected": true, "text": "", "value": "" },
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Taxa de erros por serviço",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({service=~\"$service\", level=\"error\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Stream de erros",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\", level=\"error\"} |= \"$search\""
        }
      ]
    }
  ]
}
