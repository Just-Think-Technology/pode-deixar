{
  "title": "Pode Deixar — Traces lentos",
  "uid": "pode-deixar-traces",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": { "type": "tempo", "uid": "tempo" },
        "definition": "label_values(resource.service.name)",
        "query": { "query": "label_values(resource.service.name)", "refId": "ServiceVarQuery" },
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "minDuration",
        "label": "Duração mínima",
        "type": "custom",
        "query": "200ms,500ms,1s,2s,5s",
        "current": { "selected": true, "text": "1s", "value": "1s" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Traces acima do corte",
      "type": "traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 16 },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"$service\" && duration > ${minDuration} }",
          "limit": 20
        }
      ]
    }
  ]
}
